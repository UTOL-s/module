# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=password
DB_NAME=utol_api
DB_SSLMODE=disable

# SuperTokens Configuration
SUPERTOKENS_CONNECTION_URI=your_supertokens_connection_uri
SUPERTOKENS_CONNECTION_API_KEY=your_supertokens_api_key
SUPERTOKENS_APP_NAME=UTOL API
SUPERTOKENS_API_DOMAIN=http://localhost:8080
SUPERTOKENS_WEBSITE_DOMAIN=http://localhost:3000
SUPERTOKENS_API_BASE_PATH=/api/auth
SUPERTOKENS_WEB_BASE_PATH=/api/auth

# Email Configuration
SUPERTOKENS_EMAIL_HOST=smtp.gmail.com
SUPERTOKENS_EMAIL_PASSWORD=your_email_password
SUPERTOKENS_EMAIL=your_email@gmail.com

# Server Configuration
SERVER_HOST=0.0.0.0
SERVER_PORT=8080

# Application Configuration
APP_NAME=Unified Transport Operations League API
APP_VERSION=1.0.0
APP_ENVIRONMENT=development 